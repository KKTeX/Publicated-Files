\ProvidesPackage{PracticeBox}[2026/08/04, v1.1.0]
\RequirePackage[most]{tcolorbox}
\RequirePackage{varwidth}

\newcommand{\PracticeBox@setparindent}[1]{%
  \setlength{\parindent}{#1}\relax%
}
\newdimen\PracticeBox@parindent
\ifdefined\zw
  \PracticeBox@parindent=\zw
\else
  \PracticeBox@parindent=1em
\fi

% The public argument order remains: title, optional trailing label, options.
% Character counting and extraction now use expl3, so no direct Lua calls or
% global counters are needed.
\ExplSyntaxOn

\tl_new:N \l__practicebox_title_tl
\int_new:N \l__practicebox_title_length_int

\DeclareTColorBox{practicebox}{ m O{} O{} }{%
  enhanced, sharp~corners, colback=black!10!white, colframe=black!10!white,
  attach~boxed~title~to~top~left={xshift=0mm, yshift=1mm},
  fonttitle=\gtfamily, varwidth~boxed~title=0.85\linewidth,
  breakable, arc=0mm, title={#1}, enlarge~top~by=2mm,
  boxed~title~style={empty, arc=0pt, outer~arc=0pt, boxrule=0pt},
  before~upper={\PracticeBox@setparindent{\PracticeBox@parindent}},
  underlay~unbroken~and~first={
    \draw[black, ultra~thick] (frame.north~west) -- (frame.north~east);
    \draw[black] ([yshift=-.8mm]frame.north~west) -- ([yshift=-.8mm]frame.north~east);
    \tl_set:Nn \l__practicebox_title_tl { #1 }
    \int_set:Nn \l__practicebox_title_length_int
      { \tl_count:N \l__practicebox_title_tl }
    \int_step_inline:nn { \l__practicebox_title_length_int } {
      \int_if_odd:nTF { ##1 } {
        \fill[black]
          ([xshift=\dimexpr 6mm * (##1 - 1)\relax, yshift=1mm]frame.north~west)
          rectangle +(6mm, 6mm);
        \node[white] at
          ([xshift=\dimexpr 3mm + 6mm * (##1 - 1)\relax, yshift=4mm]frame.north~west)
          { \large\textgt{\tl_item:Nn \l__practicebox_title_tl { ##1 }} };
      }
      {
        \node at
          ([xshift=\dimexpr 3mm + 6mm * (##1 - 1)\relax, yshift=4mm]frame.north~west)
          { \large\textgt{\tl_item:Nn \l__practicebox_title_tl { ##1 }} };
      }
    }
    \draw[thick] ([yshift=1mm]frame.north~west) -- ++(0mm, 6mm)
      -- ++(\dimexpr 6mm * \l__practicebox_title_length_int\relax, 0mm)
      -- node[right=2mm] {\textgt{#2}} ++(0mm, -6mm) -- cycle;
  },
  underlay~unbroken~and~last={
    \draw[black, ultra~thick] (frame.south~west) -- (frame.south~east);
    \draw[black] ([yshift=.8mm]frame.south~west) -- ([yshift=.8mm]frame.south~east);
  }, #3
}

\ExplSyntaxOff

\endinput
